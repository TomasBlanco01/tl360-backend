# Cadena de conexión de Supabase (Project Settings -> Database -> Connection string -> URI).
# En Render usar el POOLER (host aws-0-<región>.pooler.supabase.com, usuario postgres.<ref>):
# el host directo db.<ref>.supabase.co es solo IPv6 y Render no lo alcanza (PoolTimedOut).
#  - Session pooler (5432): todo funciona, incluidas las migraciones.
#  - Transaction pooler (6543): el backend desactiva las sentencias preparadas solo; para las
#    migraciones definí MIGRATE_DATABASE_URL (session pooler) o corrélas antes y usá RUN_MIGRATIONS=false.
DATABASE_URL=postgres://usuario:password@host:5432/postgres
# MIGRATE_DATABASE_URL=postgres://...
# RUN_MIGRATIONS=false

# Mismo secreto que usaba el backend Express (TpFinal-backend-main/.env), para que los
# tokens JWT sigan siendo válidos durante la transición si hace falta.
JWT_SECRET=supersecreto

PORT=3001

FRONTEND_URL=http://localhost:5173

# Correo transaccional (verificación, recuperación, turnos y verificación de comercios).
# Sin SMTP_HOST los correos se escriben en el log del servidor (modo desarrollo/pruebas).
# Ejemplo Brevo: smtp-relay.brevo.com:587. Resend: smtp.resend.com:587. Gmail: smtp.gmail.com:587.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=usuario
# SMTP_PASSWORD=clave
# SMTP_FROM=TL360 <no-reply@tudominio.com>

# Web Push (RNF-04/RF-14). Sin VAPID_PRIVATE_KEY quedan apagados los avisos, los
# recordatorios y el resumen semanal; la API responde 404 en GET /api/push/clave-publica.
# Generá el par con: node tools/vapid.mjs
# VAPID_PRIVATE_KEY=clave-privada-base64url
# VAPID_SUBJECT=mailto:admin@tudominio.com

# En producción: APP_ENV=production exige un JWT_SECRET de 32+ caracteres.
# APP_ENV=production
# CORS_ORIGINS=https://tu-front.vercel.app
